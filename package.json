{
  "name": "markdown-studio",
  "version": "0.3.0",
  "productName": "Markdown Studio",
  "description": "Editeur Markdown de bureau avec prise en charge de Mermaid",
  "author": "Fred <fred@lagage.fr>",
  "homepage": "mailto:fred@lagage.fr",
  "desktopName": "Markdown Studio",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "test": "vitest run",
    "preview": "electron-vite preview",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@tiptap/extension-code-block": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "html-to-docx": "^1.8.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "node-emoji": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "fr.lagage.markdownstudio",
    "productName": "Markdown Studio",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "category": "Office",
      "syncDesktopName": true,
      "mimeTypes": [
        "text/markdown"
      ],
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons"
    },
    "deb": {
      "packageCategory": "utils"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markdown Studio"
    }
  }
}
